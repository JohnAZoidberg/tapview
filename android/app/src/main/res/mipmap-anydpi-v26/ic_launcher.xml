<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: a touchpad outline with two contact dots, the same
     magenta/teal the visualizer uses for the first and second finger.
     Adaptive-icon-only (no PNG mipmaps) is fine at minSdk 26, which is where
     adaptive icons start. The monochrome layer (Android 13+ themed icons)
     reuses the foreground; the launcher tints it to one color anyway. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
